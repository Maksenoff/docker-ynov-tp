            "uid": "prometheus"
          },
          "expr": "sum(up{job=\"worker\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
