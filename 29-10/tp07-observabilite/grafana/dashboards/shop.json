    {
      "id": 12,
      "type": "logs",
      "title": "Logs en erreur (stack shop)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=\"shop\", level=~\"50|60|ERROR|CRITICAL\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Commandes rejetees (worker)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
